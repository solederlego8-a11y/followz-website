---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>{{ site.url }}/</loc></url>
<url><loc>{{ site.url }}/service/</loc></url>
<url><loc>{{ site.url }}/pricing/</loc></url>
<url><loc>{{ site.url }}/blog/</loc></url>
<url><loc>{{ site.url }}/faq/</loc></url>
<url><loc>{{ site.url }}/contact/</loc></url>
<url><loc>{{ site.url }}/privacy/</loc></url>
{%- for post in collections.blogPosts %}
<url><loc>{{ site.url }}{{ post.url }}</loc></url>
{%- endfor %}
</urlset>
