<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.defaultTitle }}</title>
<meta name="description" content="{{ description or site.defaultDescription }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="robots" content="index, follow">
<meta name="google-site-verification" content="Vw5B0_5HLzh_5yud3Tu4cbbksDnyCOnPAHgXWp2_6z0" />
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.defaultTitle }}">
<meta property="og:description" content="{{ description or site.defaultDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">F</span>
      <span class="brand-text">{{ site.name }}</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-input">
    <label for="nav-toggle" class="nav-toggle" aria-label="メニュー">
      <span></span><span></span><span></span>
    </label>
    <nav class="site-nav">
      <a href="/about/">会社概要</a>
      <a href="/service/">サービス</a>
      <a href="/pricing/">料金</a>
      <a href="/blog/">ブログ</a>
      <a href="/faq/">FAQ</a>
      <a href="/contact/" class="cta">無料相談</a>
    </nav>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-about">
      <p class="footer-brand"><span class="brand-mark" aria-hidden="true">F</span>{{ site.name }}</p>
      <p class="footer-slogan">{{ site.slogan }}</p>
    </div>
    <div class="footer-col">
      <p class="footer-heading">サービス</p>
      <nav class="footer-nav">
        <a href="/service/">サービス内容</a>
        <a href="/pricing/">料金</a>
        <a href="/blog/">ブログ</a>
        <a href="/faq/">FAQ</a>
      </nav>
    </div>
    <div class="footer-col">
      <p class="footer-heading">会社情報</p>
      <nav class="footer-nav">
        <a href="/about/">会社概要</a>
        <a href="/contact/">お問い合わせ</a>
        <a href="/privacy/">プライバシーポリシー</a>
      </nav>
    </div>
  </div>
  <div class="wrap">
    <p class="copyright">&copy; {{ "now" | date("yyyy") }} {{ site.name }}</p>
  </div>
</footer>
</body>
</html>
